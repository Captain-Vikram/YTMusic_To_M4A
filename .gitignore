# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/
.env

# PyInstaller
*.spec

# Installer logs
pip-log.txt

# Unit test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints

# mypy
.mypy_cache/

# Logs
*.log

# Database / runtime files
*.sqlite3
*.db

# Backup folder (recommended to keep out of VCS)
# Remove this line if you want to keep backups tracked in git
backups/

# Thumbnails / caches
thumbnails/
*.png
*.jpg

# Temporary files
*.tmp
*.swp

# Local settings
local_settings.py

# Ignore built artifacts
dist/
build/
*.egg-info/

# End of .gitignore
